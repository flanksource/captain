---
model: claude-agent-opus
backend: claude-cli
budget:
  maxTurns: 3
permissions:
  mode: default
  tools:
    allow:
      - Read
      - Glob
      - Grep
    modes:
      Bash: ask
memory:
  skipHooks: true
  skipUser: true
---
